# Clave de API de Groq -> https://console.groq.com/keys
GROQ_API_KEY= Aqui iria la api

# Proveedor y modelo del LLM (se puede cambiar sin tocar el codigo).
# Modelo por defecto del proyecto: openai/gpt-oss-120b (no cambiar sin acordarlo).
# Alternativa mas rapida (menor calidad): openai/gpt-oss-20b
# Catalogo vivo de modelos disponibles en Groq: https://api.groq.com/openai/v1/models
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Clave de API de Groq -> https://console.groq.com/keys
GROQ_API_KEY= Aqui iria la api

# Proveedor y modelo del LLM (se puede cambiar sin tocar el codigo).
# Modelo por defecto del proyecto: openai/gpt-oss-120b (no cambiar sin acordarlo).
# Alternativa mas rapida (menor calidad): openai/gpt-oss-20b
# Catalogo vivo de modelos disponibles en Groq: https://api.groq.com/openai/v1/models
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# --- Base de conocimiento (RAG): Postgres con pgvector ---
# docker-compose.yml crea la base con estos datos. Los valores de host y puerto
# son para conectarse desde esta computadora; dentro de Docker el compose los
# cambia solo (host "postgres", puerto 5432).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=conocimiento
POSTGRES_USER=agroia
# Elige una contrasena propia; no uses esta ni la subas al repositorio.
POSTGRES_PASSWORD=cambia_esta_contrasena
# Opcional: URL completa (driver psycopg 3). Si tiene valor, se ignoran los POSTGRES_*.
# DATABASE_URL=postgresql+psycopg://usuario:contrasena@host:5432/base
DATABASE_URL=

# --- RAG: embeddings y recuperacion ---
# Modelo local elegido en el bake-off; usa los prefijos "passage:" y "query:".
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
RAG_COLLECTION=conocimiento_aguacate
# Fragmentos que devuelve cada consulta.
RAG_TOP_K=4

# Puerto del agente al usar docker compose (en esta computadora).
AGENTE_PORT=8000
